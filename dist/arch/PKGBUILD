pkgver() {
  cd omafind
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd omafind
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd omafind
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # Not --frozen: the ort crate downloads its ONNX Runtime build here.
  cargo build --release --locked
}

check() {
  cd omafind
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --release --locked
}

package_omafind-git() {
  depends=(gcc-libs glibc libheif poppler)
  optdepends=('omafind-models: models preinstalled (otherwise run `omafind models fetch`)')
  provides=(omafind)
  conflicts=(omafind)
  cd omafind
  install -Dm755 target/release/omafind -t "$pkgdir/usr/bin"
  install -Dm644 dist/systemd/omafind.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 dist/omarchy/omafind.search/* -t "$pkgdir/usr/share/omafind/omarchy/omafind.search"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/omafind"
  install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_omafind-models() {
  pkgdesc='Models for omafind: EmbeddingGemma 2 (q4 ONNX, text and vision) and Model2Vec static models'
  arch=(any)
  license=(Apache-2.0 MIT)
  local m
  for m in "${_models[@]}"; do
    install -Dm644 "$srcdir/${m//\//__}" "$pkgdir/usr/share/omafind/models/$m"
  done
  install -Dm644 omafind/NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
